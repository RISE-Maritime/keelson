{
	"name": "Keelson Development",
	// Prebuilt base: Python, uv, protodot, graphviz and ArduPilot SITL, from
	// .devcontainer/base/Dockerfile. See .devcontainer/README.md to build it
	// locally under this same tag when the registry is unreachable.
	"image": "ghcr.io/rise-maritime/keelson-devcontainer:rover-4.5",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/devcontainers-extra/features/claude-code:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"runArgs": [
		"--network=host",
		"--name=devcont-keelson",
		"--device-cgroup-rule=c 166:* rmw"
	],
	"mounts": [
		"source=/dev,target=/dev,type=bind",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/,target=/home/vscode/.claude/,type=bind",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh/,target=/home/vscode/.config/gh/,type=bind"
	],
	"postCreateCommand": "bash .devcontainer/post-create-script.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"tamasfe.even-better-toml",
				"zxh404.vscode-proto3"
			],
			"settings": {
				"python.terminal.activateEnvironment": true,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true
				}
			}
		}
	}
}
